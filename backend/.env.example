# Copy this file to .env and fill in your own values.

# Your Aiven PostgreSQL connection string.
# Find it in the Aiven console: open your service -> Overview tab -> "Service URI".
# It looks like: postgres://avnadmin:PASSWORD@your-service.aivencloud.com:PORT/defaultdb?sslmode=require
DATABASE_URL=AIVEN_DATABASE_URL=postgres://user:password@your-host:port/dbname

# Aiven requires SSL — keep this true.
PGSSL=true

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login token stays valid.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=4000

# Comma-separated list of frontend origins allowed to call this API (for CORS).
# The React frontend's Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173
